{
  "expo": {
    "name": "Vaqit — Prayer Companion",
    "slug": "vaqit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C1422"
    },
    "updates": {
      "url": "https://u.expo.dev/fb881a3d-19bd-489c-a95d-413b9bc38d10",
      "enabled": false,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "online.vaqit.app",
      "appleTeamId": "NAC8L7HCJL",
      "buildNumber": "1",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.online.vaqit.app"
        ]
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "Vaqit needs your location to calculate accurate prayer times and the Qibla direction for your city.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Vaqit needs your location to calculate accurate prayer times and the Qibla direction for your city.",
        "NSMotionUsageDescription": "Vaqit uses your device's compass to show the Qibla direction."
      }
    },
    "android": {
      "package": "online.vaqit.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#4ADE80",
          "sounds": [
            "./assets/sounds/athan.wav",
            "./assets/sounds/athan_fajr.wav"
          ],
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vaqit needs your location to calculate accurate prayer times and the Qibla direction for your city.",
          "locationAlwaysAndWhenInUsePermission": "Vaqit needs your location to calculate accurate prayer times and the Qibla direction for your city."
        }
      ],
      [
        "expo-updates",
        {
          "launchWaitMs": 0
        }
      ],
      "./plugins/withAthanService",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "@bacons/apple-targets"
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "revenueCatApiKeyIos": "appl_xibxFOhkFnxCsCtopWrnxOInmao",
      "revenueCatApiKeyAndroid": "",
      "eas": {
        "projectId": "fb881a3d-19bd-489c-a95d-413b9bc38d10",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "online.vaqit.app.widget",
                  "targetName": "VaqitWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.online.vaqit.app"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "cenkkara"
  }
}
